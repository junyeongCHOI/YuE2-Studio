#!/usr/bin/env bash
# One command from a fresh clone to a running dashboard.
#
# Creates the environment, fetches the model weights and starts the server. Every
# step is skipped when it is already done, so this is also the normal way to
# start the app day to day.
set -euo pipefail
cd "$(dirname "$0")"

PORT=8710
OPEN=1
MODELS=1
TRANSCRIPTION=0
BACKEND=mlx
MODEL=""
LIST_MODELS=0
KEEP_ORIGINALS=0

usage() {
    cat <<'USAGE'
사용법: ./start [옵션]

  --port <번호>       대시보드 포트 (기본 8710)
  --no-open           브라우저를 열지 않음
  --skip-models       가중치 확인/다운로드를 건너뜀 (이미 받아둔 경우)
  --with-transcription  오디오 전사용 SheetSage2 도 함께 설치 (약 2.8GB)
  --backend <mlx|torch>  곡 생성 백엔드 (기본 mlx — 약 2.7배 빠름)
  --torch             --backend torch 와 같음 (릴리스 가중치 그대로)
  --model <경로>      쓸 MLX 변환본 (기본 models/YuE2-3B-mlx-8bit)
  --list-models       쓸 수 있는 모델을 보여주고 종료
  --keep-originals    변환이 끝나도 원본 가중치(YuE2-3B, MERT-v2)를 지우지 않음
  -h, --help          이 도움말

처음 실행하면 YuE2 가중치 약 7.8GB 를 받아 MLX 로 변환하고(4.9GB), 변환이 끝나면
원본 YuE2-3B(6.8GB)를 지웁니다. 두 번째부터는 바로 뜹니다. 대시보드 헤더에서도
모델을 바꿀 수 있습니다.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --port) PORT="${2:?--port 에 번호가 필요합니다}"; shift 2 ;;
        --no-open) OPEN=0; shift ;;
        --skip-models) MODELS=0; shift ;;
        --with-transcription) TRANSCRIPTION=1; shift ;;
        --backend) BACKEND="${2:?--backend 에 mlx 또는 torch 가 필요합니다}"; shift 2 ;;
        --torch) BACKEND=torch; shift ;;
        --model) MODEL="${2:?--model 에 경로가 필요합니다}"; BACKEND=mlx; shift 2 ;;
        --list-models) LIST_MODELS=1; shift ;;
        --keep-originals) KEEP_ORIGINALS=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "알 수 없는 옵션: $1" >&2; usage >&2; exit 2 ;;
    esac
done

case "$BACKEND" in
    mlx|torch) ;;
    *) echo "--backend 는 mlx 또는 torch 입니다: $BACKEND" >&2; exit 2 ;;
esac

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$1" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- prerequisites

[ "$(uname -s)" = "Darwin" ] || warn "Apple Silicon 용으로 만들어졌습니다. 다른 환경에서는 CPU 로 돌아 매우 느립니다."

if ! command -v uv >/dev/null 2>&1; then
    die "uv 가 필요합니다. 설치: curl -LsSf https://astral.sh/uv/install.sh | sh"
fi

if [ "$LIST_MODELS" = 0 ] && lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    die "포트 $PORT 가 이미 사용 중입니다. --port 로 다른 포트를 쓰거나 기존 서버를 종료하세요."
fi

# ---------------------------------------------------------------- environment

if [ ! -x .venv/bin/python ]; then
    step "Python 3.12 가상환경 생성"
    uv venv --python 3.12 .venv
fi

step "의존성 확인"
VIRTUAL_ENV="$PWD/.venv" uv pip install --quiet -r requirements.txt
echo "  준비됨"

if [ "$LIST_MODELS" = 1 ]; then
    .venv/bin/python - <<'PYTHON'
import mlx_backend
original = mlx_backend.torch_available()
rows = [("torch", "PyTorch bf16 (원본)",
         "릴리스 가중치 그대로, MPS" + ("" if original else " · 받지 않음 (7.26GB)"))]
for model in mlx_backend.discover():
    stages = "토큰 생성 + 합성" if "nar" in model["stages"] else "토큰 생성만"
    rows.append((model["id"], model["label"], f"{stages} · {model['bytes'] / 2**30:.1f}GB"))
width = max(len(row[0]) for row in rows)
print()
for identifier, label, detail in rows:
    print(f"  {identifier:<{width}}  {label:<22} {detail}")
print("\n  ./start --model <경로>   또는   ./start --torch")
PYTHON
    exit 0
fi

# ---------------------------------------------------------------- weights

if [ "$MODELS" = 1 ]; then
    # A conversion that carries synthesis and the tokenizer replaces the released
    # checkpoint, so once it exists the original may be deleted and is not fetched.
    if [ "$BACKEND" = mlx ] && .venv/bin/python -c 'import sys, mlx_backend; sys.exit(0 if mlx_backend.self_contained(sys.argv[1] or None) else 1)' "$MODEL"; then
        step "VAE 가중치 확인 (YuE2-Vae 530MB)"
        echo "  MLX 변환본이 있어 원본 YuE2-3B 는 필요 없습니다."
        .venv/bin/python download_models.py --vae-only
    else
        step "YuE2 가중치 확인 (YuE2-3B 7.26GB + YuE2-Vae 530MB)"
        echo "  이미 받아두었으면 즉시 넘어갑니다. 처음이면 시간이 걸립니다."
        .venv/bin/python download_models.py
    fi
fi

# Whether a converted model is usable is the loader's question, not a file
# test: the server skips anything mlx_backend.available() rejects, so asking
# anything else here can leave the two disagreeing.
if [ "$BACKEND" = mlx ]; then
    if ! .venv/bin/python -c 'import sys, mlx_backend; sys.exit(0 if mlx_backend.mlx_importable() else 1)'; then
        warn "이 환경에는 mlx 를 설치할 수 없습니다 (Apple Silicon 전용). PyTorch 백엔드로 계속합니다."
        BACKEND=torch
    elif ! .venv/bin/python -c 'import sys, mlx_backend; sys.exit(0 if mlx_backend.available(sys.argv[1] or None) else 1)' "$MODEL"; then
        if [ -n "$MODEL" ]; then
            die "$MODEL 에 쓸 수 있는 변환본이 없습니다. mlx_convert.py --out $MODEL 로 만들거나 --model 없이 실행하세요."
        fi
        step "모델을 MLX 로 변환 (토큰 생성 8비트 / 합성 BF16, 4.9GB, 한 번만)"
        echo "  변환은 20초 정도 걸립니다. 이후 실행에서는 건너뜁니다."
        if ! .venv/bin/python mlx_convert.py; then
            warn "변환에 실패했습니다. PyTorch 백엔드로 계속합니다."
            BACKEND=torch
        # The conversion stands in for the released checkpoint entirely (tokenizer
        # included); only keep the original if something here still needs it.
        elif [ "$KEEP_ORIGINALS" = 0 ] \
             && .venv/bin/python -c 'import sys, mlx_backend; sys.exit(0 if mlx_backend.self_contained() else 1)'; then
            step "원본 YuE2-3B 삭제 (변환본만으로 곡을 만듭니다)"
            .venv/bin/python prune_models.py m-a-p/YuE2-3B
            echo "  --torch 로 실행하면 다시 받습니다. 지우지 않으려면 --keep-originals."
        fi
    fi
fi

if [ "$TRANSCRIPTION" = 1 ] && [ ! -x .venv-sheetsage/bin/python ]; then
    step "SheetSage2 설치 (오디오 전사용, 약 2.8GB)"
    ./setup_sheetsage.sh
fi

# Transcription's audio encoder runs on MLX once converted (mlx_sheetsage.py):
# faster and lighter than PyTorch, same score. This covers fresh installs and
# ones from before the conversion existed. The pin matches requirements.txt.
if [ -x .venv-sheetsage/bin/python ] && [ -f sheetsage2/infer.py ] \
   && [ ! -f models/SheetSage2-encoder-mlx/encoder.safetensors ] \
   && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
    step "전사 인코더를 MLX 로 변환 (1.2GB, 한 번만)"
    echo "  원본 MERT-v2(2.4GB)가 없으면 먼저 받습니다."
    if VIRTUAL_ENV="$PWD/.venv-sheetsage" uv pip install --quiet "mlx==0.32.2" \
       && .venv-sheetsage/bin/python mlx_sheetsage.py convert; then
        echo "  이후 전사는 인코더를 MLX 로 돌립니다."
        # sheetsage_runner.py answers SheetSage2's check on the parent from the
        # conversion record, so the MLX path never reads it again.
        if [ "$KEEP_ORIGINALS" = 0 ]; then
            step "원본 MERT-v2 삭제 (변환본만으로 전사합니다)"
            .venv/bin/python prune_models.py m-a-p/MERT-v2-FullSong
        fi
    else
        warn "변환에 실패했습니다. 전사는 PyTorch 로 계속합니다."
    fi
fi

# ---------------------------------------------------------------- run

step "대시보드 시작"
export YUE2_BACKEND="$BACKEND"
if [ "$BACKEND" = mlx ]; then
    [ -n "$MODEL" ] && export YUE2_MODEL="$MODEL"
    echo "  모델: ${MODEL:-models/YuE2-3B-mlx-8bit} (토큰 생성·합성), VAE 디코드는 PyTorch"
else
    echo "  모델: PyTorch bf16 원본"
fi
URL="http://127.0.0.1:$PORT"
echo "  $URL"
echo "  종료하려면 Ctrl+C"

if [ "$OPEN" = 1 ] && command -v open >/dev/null 2>&1; then
    # Give uvicorn a moment to bind before the browser asks for the page.
    ( sleep 2; open "$URL" >/dev/null 2>&1 || true ) &
fi

exec .venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port "$PORT"
